    memoryPercent = 50;
    priority = 100;
  };

  swapDevices = [
    {
      device = "/swapfile";
      size = 8 * 1024;
      priority = 10;
    }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "aarch64-linux";
}
