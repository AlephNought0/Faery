{
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/6947b2c1-24c6-4045-971b-5f6dea815a23";
    fsType = "xfs";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/7A86-18F1";
    fsType = "vfat";
    options = ["fmask=0022" "dmask=0022"];
